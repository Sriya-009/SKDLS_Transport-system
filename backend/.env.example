FLASK_ENV=production

SECRET_KEY=
JWT_SECRET_KEY=

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=transport_system
DB_PORT=3306

FRONTEND_ORIGIN=http://34.200.212.3
CORS_ORIGINS=http://34.200.212.3

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true

PREFERRED_URL_SCHEME=https

API_RATE_LIMIT=120 per minute
RATELIMIT_STORAGE_URI=memory://

MAX_CONTENT_LENGTH_BYTES=10485760

GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKER_CLASS=gthread
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM_NUMBER=

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_DEFAULT_QUEUE=transport-default
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=[no-reply@skdls.com](mailto:no-reply@skdls.com)

ENABLE_AI_METRICS=true
ENABLE_AI_STREAMING=true
ENABLE_AI_REPLAY=true

ENABLE_LIVE_TRACKING=true
TRACKING_UPDATE_INTERVAL=5

ENABLE_BACKGROUND_WORKERS=true
HEALTH_SNAPSHOT_INTERVAL_SECONDS=60
RETRY_QUEUE_SCAN_INTERVAL_SECONDS=120
AUDIT_LOG_RETENTION_DAYS=180

LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
